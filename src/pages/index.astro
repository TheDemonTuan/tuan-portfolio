---
import Icon from "../components/Icon.astro";
import Navigation from "../components/Navigation";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Nguyễn Viết Tuấn — Software Builder";
const description =
  "Portfolio của Nguyễn Viết Tuấn — xây dựng phần mềm, công cụ AI và hạ tầng web có chủ đích.";
const githubUrl = "https://github.com/TheDemonTuan";
const omniRouteUrl = "https://github.com/TheDemonTuan/OmniRoute";
---

<BaseLayout title={title} description={description}>
  <Navigation client:load />

  <main id="main-content">
    <section class="hero shell" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow reveal">PORTFOLIO / 2026</p>
        <h1 id="hero-title" class="reveal reveal-delay-1">
          <span data-copy="vi">Xây sản phẩm số<br />có <em>chủ đích.</em></span>
          <span data-copy="en">Building digital<br />products with <em>intent.</em></span>
        </h1>
        <p class="hero-description reveal reveal-delay-2">
          <span data-copy="vi">
            Tôi là <strong>Nguyễn Viết Tuấn</strong> — tập trung vào những trải nghiệm web nhanh, công
            cụ AI hữu ích và hệ thống vận hành gọn gàng.
          </span>
          <span data-copy="en">
            I’m <strong>Nguyễn Viết Tuấn</strong> — focused on fast web experiences, useful AI tools,
            and systems that stay simple to operate.
          </span>
        </p>
        <div class="hero-actions reveal reveal-delay-3">
          <a class="button button-primary" href="#work">
            <span data-copy="vi">Xem dự án</span>
            <span data-copy="en">View work</span>
            <Icon name="arrow" />
          </a>
          <a class="button button-quiet" href={githubUrl} target="_blank" rel="noreferrer">
            <Icon name="github" /> GitHub
          </a>
        </div>
      </div>

      <div class="hero-visual reveal reveal-delay-2" aria-hidden="true">
        <div class="orbit orbit-outer"><span></span></div>
        <div class="orbit orbit-inner"></div>
        <div class="monogram">NT</div>
        <div class="coordinate coordinate-top">21.0285° N</div>
        <div class="coordinate coordinate-bottom">105.8542° E</div>
        <div class="signal signal-one"></div>
        <div class="signal signal-two"></div>
      </div>

      <div class="scroll-cue" aria-hidden="true">
        <span>SCROLL</span><i></i>
      </div>
    </section>

    <section class="section shell about" id="about" aria-labelledby="about-title">
      <div class="section-index" aria-hidden="true">01</div>
      <div class="section-heading">
        <p class="eyebrow">
          <span data-copy="vi">ĐÔI NÉT</span><span data-copy="en">ABOUT</span>
        </p>
        <h2 id="about-title">
          <span data-copy="vi">Ít ồn ào.<br /><em>Nhiều giá trị.</em></span>
          <span data-copy="en">Less noise.<br /><em>More signal.</em></span>
        </h2>
      </div>
      <div class="about-body">
        <p class="about-lead">
          <span data-copy="vi">
            Tôi thích biến một vấn đề phức tạp thành sản phẩm rõ ràng — từ giao diện người dùng đến
            cách hệ thống chạy phía sau.
          </span>
          <span data-copy="en">
            I enjoy turning a complex problem into a clear product — from the interface people use
            to the systems running behind it.
          </span>
        </p>
        <p>
          <span data-copy="vi">
            Cách làm việc của tôi ưu tiên hiệu năng, khả năng tiếp cận và những quyết định kỹ thuật
            đủ đơn giản để bảo trì lâu dài. Tôi khám phá các công cụ AI mới, nhưng luôn đặt trải
            nghiệm thật của người dùng lên trước hiệu ứng bề mặt.
          </span>
          <span data-copy="en">
            My work favors performance, accessibility, and technical choices simple enough to
            maintain. I explore emerging AI tools, while keeping real user experience ahead of
            surface-level effects.
          </span>
        </p>
        <div class="principles" aria-label="Working principles">
          <div>
            <span>01</span><strong data-copy="vi">Rõ ràng</strong><strong data-copy="en"
              >Clear</strong
            >
          </div>
          <div>
            <span>02</span><strong data-copy="vi">Có ích</strong><strong data-copy="en"
              >Useful</strong
            >
          </div>
          <div>
            <span>03</span><strong data-copy="vi">Bền vững</strong><strong data-copy="en"
              >Durable</strong
            >
          </div>
        </div>
      </div>
    </section>

    <section class="section project-section" id="work" aria-labelledby="work-title">
      <div class="shell">
        <div class="section-index" aria-hidden="true">02</div>
        <div class="project-heading">
          <div>
            <p class="eyebrow">
              <span data-copy="vi">DỰ ÁN NỔI BẬT</span><span data-copy="en">SELECTED WORK</span>
            </p>
            <h2 id="work-title">
              <span data-copy="vi">Đang xây.<br /><em>Đang học.</em></span>
              <span data-copy="en">Currently building.<br /><em>Always learning.</em></span>
            </h2>
          </div>
          <p>
            <span data-copy="vi">Một dự án mã nguồn mở tôi đang phát triển và thử nghiệm.</span>
            <span data-copy="en">An open-source project I’m developing and experimenting with.</span
            >
          </p>
        </div>

        <article class="project-card">
          <div class="project-art" aria-hidden="true">
            <div class="route-map">
              <span class="route-node node-a">01</span>
              <span class="route-node node-b">AI</span>
              <span class="route-node node-c">350+</span>
              <span class="route-node node-d">API</span>
              <svg viewBox="0 0 600 380" preserveAspectRatio="none">
                <path d="M66 70 C230 70, 165 190, 300 190 S430 310, 540 310"></path>
                <path d="M66 305 C190 305, 210 190, 300 190 S440 70, 540 70"></path>
                <circle cx="300" cy="190" r="7"></circle>
              </svg>
              <div class="route-center">OMNI<br />ROUTE</div>
            </div>
          </div>
          <div class="project-info">
            <div class="project-meta">
              <span>01 / OPEN SOURCE</span>
              <span>2026</span>
            </div>
            <h3>OmniRoute</h3>
            <p>
              <span data-copy="vi">
                AI gateway hợp nhất nhiều nhà cung cấp qua một endpoint, với định tuyến và tự động
                fallback. Một không gian để tôi làm việc với TypeScript, streaming, Docker và vận
                hành hệ thống thực tế.
              </span>
              <span data-copy="en">
                An AI gateway unifying multiple providers behind one endpoint, with routing and
                automatic fallback. A place where I work with TypeScript, streaming, Docker, and
                real-world operations.
              </span>
            </p>
            <ul class="tag-list" aria-label="Technologies">
              <li>TypeScript</li><li>Next.js</li><li>Docker</li><li>AI Gateway</li>
            </ul>
            <div class="project-links">
              <a href={omniRouteUrl} target="_blank" rel="noreferrer">
                <Icon name="github" />
                <span data-copy="vi">Mã nguồn</span><span data-copy="en">Source</span>
              </a>
              <a href="https://omniroute.online" target="_blank" rel="noreferrer">
                <Icon name="external" />
                <span data-copy="vi">Trang dự án</span><span data-copy="en">Project site</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="section shell stack-section" id="stack" aria-labelledby="stack-title">
      <div class="section-index" aria-hidden="true">03</div>
      <div class="section-heading">
        <p class="eyebrow">
          <span data-copy="vi">CÔNG CỤ</span><span data-copy="en">TOOLKIT</span>
        </p>
        <h2 id="stack-title">
          <span data-copy="vi">Công nghệ<br /><em>đang dùng.</em></span>
          <span data-copy="en">Tools I use<br /><em>to build.</em></span>
        </h2>
      </div>
      <div class="stack-grid">
        <article>
          <span class="stack-icon"><Icon name="code" size={26} /></span>
          <p class="stack-number">01</p>
          <h3><span data-copy="vi">Giao diện</span><span data-copy="en">Interface</span></h3>
          <p>TypeScript · React · Astro · Next.js · CSS</p>
        </article>
        <article>
          <span class="stack-icon"><Icon name="layers" size={26} /></span>
          <p class="stack-number">02</p>
          <h3><span data-copy="vi">Hệ thống</span><span data-copy="en">Systems</span></h3>
          <p>Node.js · REST · Streaming · SQLite · Redis</p>
        </article>
        <article>
          <span class="stack-icon"><Icon name="terminal" size={26} /></span>
          <p class="stack-number">03</p>
          <h3><span data-copy="vi">Vận hành</span><span data-copy="en">Operations</span></h3>
          <p>Docker · Caddy · Cloudflare · Linux · GitHub</p>
        </article>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="contact-grid" aria-hidden="true"></div>
      <div class="shell contact-inner">
        <p class="eyebrow">
          <span data-copy="vi">KẾT NỐI</span><span data-copy="en">GET IN TOUCH</span>
        </p>
        <h2 id="contact-title">
          <span data-copy="vi">Cùng tạo ra thứ<br /><em>đáng để dùng.</em></span>
          <span data-copy="en">Let’s build something<br /><em>worth using.</em></span>
        </h2>
        <p>
          <span data-copy="vi">Xem những gì tôi đang xây dựng và kết nối với tôi trên GitHub.</span>
          <span data-copy="en">See what I’m building and connect with me on GitHub.</span>
        </p>
        <a
          class="button button-primary button-large"
          href={githubUrl}
          target="_blank"
          rel="noreferrer"
        >
          <Icon name="github" />
          <span data-copy="vi">Mở GitHub</span><span data-copy="en">Open GitHub</span>
          <Icon name="arrow" />
        </a>
      </div>
    </section>
  </main>

  <footer class="footer shell">
    <div class="brand footer-brand"><span class="brand-mark" aria-hidden="true">NT</span></div>
    <p>© {new Date().getFullYear()} NGUYỄN VIẾT TUẤN</p>
    <a href="#top"
      ><span data-copy="vi">LÊN ĐẦU TRANG ↑</span><span data-copy="en">BACK TO TOP ↑</span></a
    >
  </footer>
</BaseLayout>
