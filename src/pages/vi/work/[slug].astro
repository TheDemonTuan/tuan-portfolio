---
import { contributionBySlug } from "../../../data/contributions";
import { workPaths } from "../../../data/routes";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkDetailView from "../../../views/WorkDetailView.astro";

export const getStaticPaths = workPaths;

const { slug } = Astro.props;
const contribution = contributionBySlug(slug);
const title = `${contribution.headline.vi} — Nguyễn Viết Tuấn`;
---

<BaseLayout title={title} description={contribution.summary.vi} lang="vi">
  <WorkDetailView slug={slug} lang="vi" />
</BaseLayout>
