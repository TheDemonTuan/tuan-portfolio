---
import Icon from "../components/Icon.astro";
import { notFound } from "../data/copy";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ui } from "../data/ui";
---

<BaseLayout
  title={notFound.title.en}
  description={notFound.description.en}
  lang="en"
  indexable={false}
>
  <section class="error page" data-testid="not-found">
    <p class="overscale" style="margin: 0 0 var(--s-5)">404</p>
    <h1>{notFound.headline.en}</h1>
    <p class="lede" style="margin-top: var(--s-5)">{notFound.body.en}</p>

    <p style="margin-top: var(--s-7)">
      <a class="link-mono" href="/work/" style="margin-right: var(--s-5)">
        {ui.allContributions.en}
        <Icon name="arrow" />
      </a>
      <a class="link-mono" href="/">{ui.home.en}</a>
    </p>

    <p class="marginalia" style="margin-top: var(--s-8)">
      <a href="/vi/">Trang này bằng tiếng Việt →</a>
    </p>
  </section>
</BaseLayout>
