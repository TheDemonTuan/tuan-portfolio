---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Nguyễn Viết Tuấn" description="Trang không tồn tại.">
  <main class="error-page shell">
    <a class="brand" href="/" aria-label="Nguyễn Viết Tuấn — Home">
      <span class="brand-mark" aria-hidden="true">NT</span>
    </a>
    <p class="eyebrow">ERROR / 404</p>
    <h1>
      <span data-copy="vi">Lạc đường rồi.</span>
      <span data-copy="en">Wrong turn.</span>
    </h1>
    <p class="lede">
      <span data-copy="vi">Trang bạn tìm không tồn tại hoặc đã được di chuyển.</span>
      <span data-copy="en">The page you are looking for does not exist or has moved.</span>
    </p>
    <a class="button button-primary" href="/">
      <span data-copy="vi">Về trang chính</span>
      <span data-copy="en">Back home</span>
    </a>
  </main>
</BaseLayout>
