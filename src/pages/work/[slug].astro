---
import { articles } from "../../data/articles";
import { contributionBySlug } from "../../data/contributions";
import { workPaths } from "../../data/routes";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleDetailView from "../../views/ArticleDetailView.astro";
import WorkDetailView from "../../views/WorkDetailView.astro";

export const getStaticPaths = workPaths;

const { slug } = Astro.props;
const article = articles.find((entry) => entry.slug === slug);
const contribution = article ? null : contributionBySlug(slug);
const title = `${article ? article.title.en : contribution!.headline.en} — Nguyễn Viết Tuấn`;
const description = article ? article.description.en : contribution!.summary.en;
---

<BaseLayout title={title} description={description} lang="en">
  {article ? <ArticleDetailView slug={slug} lang="en" /> : <WorkDetailView slug={slug} lang="en" />}
</BaseLayout>
