---
import { localizePath } from "../data/i18n";
import type { Lang } from "../data/i18n";
import { provenLabel, stack } from "../data/stack";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div data-testid="stack">
  {
    stack.map((group) => (
      <div class="stack-group">
        <h3 class="label">{group.label[lang]}</h3>
        <ul class="stack-items">
          {group.items.map((item) => (
            <li class:list={[item.provenance ? "is-proven" : "is-quiet"]}>
              {item.provenance ? (
                <a href={localizePath(`/work/${item.provenance}/`, lang)} title={provenLabel[lang]}>
                  {item.name}
                </a>
              ) : (
                item.name
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
