---
import { localizePath } from "../data/i18n";
import type { Lang } from "../data/i18n";
import { personalWork } from "../data/personal-work";
import { stack } from "../data/stack";
import { ui } from "../data/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div data-testid="stack">
  {stack.map((group) => (
    <div class="stack-group">
      <h3 class="label">{group.label[lang]}</h3>
      <ul class="stack-items">
        {group.items.map((item) => {
          const source = item.provenance;
          const project =
            source.kind === "project" ? personalWork.find((entry) => entry.id === source.id) : null;
          const href =
            source.kind === "contribution"
              ? localizePath(`/work/${source.slug}/`, lang)
              : project?.url;
          if (!href) throw new Error(`Unresolved stack provenance: ${item.name}`);
          return (
            <li>
              <a href={href}>
                <span>{item.name}</span>
                <small>
                  {source.kind === "contribution"
                    ? ui.contributionSource[lang]
                    : ui.projectSource[lang]}
                  {project ? ` · ${project.title}` : ""}
                </small>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</div>
