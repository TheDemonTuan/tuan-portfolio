---
import { localizePath } from "../data/i18n";
import type { Lang } from "../data/i18n";
import { site } from "../data/site";
import { ui } from "../data/ui";
import LangToggle from "./LangToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang: Lang;
  /** Locale-neutral path of the current page, used for the active state. */
  path: string;
}

const { lang, path } = Astro.props;

const links = [
  { href: "/work/", label: ui.nav.work[lang] },
  { href: "/about/", label: ui.nav.about[lang] },
  { href: "/colophon/", label: ui.nav.colophon[lang] },
];
---

<header class="masthead page" role="banner">
  <div class="masthead__bar">
    <a class="masthead__name" href={localizePath("/", lang)}>
      <svg class="masthead__emblem" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M16 2 29 9.5v13L16 30 3 22.5v-13Z" stroke="currentColor" />
        <path
          d="M9 22V10l14 12V10M9 16l7 4 7-4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
      </svg>
      {site.name}
    </a>

    <nav class="masthead__nav" aria-label={ui.mainNav[lang]}>
      <div class="masthead__links">
        {links.map((link) => (
          <a
            href={localizePath(link.href, lang)}
            aria-current={path.startsWith(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
      <div class="masthead__tools">
        <LangToggle lang={lang} path={path} />
        <ThemeToggle lang={lang} />
      </div>
    </nav>
  </div>
</header>
