{
  "name": "tuan-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun ./node_modules/astro/bin/astro.mjs dev",
    "astro": "bun ./node_modules/astro/bin/astro.mjs",
    "typecheck": "bun ./node_modules/astro/bin/astro.mjs sync && bun check --no-script && bun ./node_modules/astro/bin/astro.mjs check",
    "build": "bun run typecheck && bun ./node_modules/astro/bin/astro.mjs build",
    "preview": "bun ./node_modules/astro/bin/astro.mjs preview",
    "fmt": "bun fmt --no-script --no-config \"**/*.{js,mjs,cjs,ts,tsx,css,html,json,yaml,yml,md,mdx,toml}\" && bunx --bun prettier --write \"src/**/*.astro\"",
    "fmt:check": "bun fmt --no-script --no-config --check \"**/*.{js,mjs,cjs,ts,tsx,css,html,json,yaml,yml,md,mdx,toml}\" && bunx --bun prettier --check \"src/**/*.astro\"",
    "check": "bun run typecheck && bun run fmt:check",
    "test:browser": "bun ./node_modules/playwright/cli.js test",
    "test": "bun run test:browser",
    "og": "bun scripts/make-og.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.2",
    "three": "0.186.1"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/three": "0.186.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "7.0.2"
  }
}
